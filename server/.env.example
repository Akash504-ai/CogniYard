PORT=5000
NODE_ENV=development
DATABASE_URL=mongodb://127.0.0.1:27017/cogniyard
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
ALLOW_PUBLIC_REGISTRATION=false
# Used only by the local starter; demo bootstrapping is always blocked in production.
DEMO_ACCOUNTS_ENABLED=true
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_INVOICE_FOLDER=cogniyard/invoices
# false keeps the offline hackathon demo usable; true enforces Cloudinary-only storage.
CLOUDINARY_REQUIRED=false
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000
BUYER_COMPANY_NAME=CogniYard Operations
BUYER_ADDRESS=Main Yard and Procurement Centre
