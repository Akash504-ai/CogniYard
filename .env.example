# Core server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=mongodb://127.0.0.1:27017/cogniyard
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ALLOW_PUBLIC_REGISTRATION=false
# Used only by the local starter; demo bootstrapping is always blocked in production.
DEMO_ACCOUNTS_ENABLED=true

# Groq AI (optional; AI actions show a useful configuration error when omitted)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cloudinary (recommended for deployment). Paste CLOUDINARY_URL for the easiest setup.
# Without credentials, the hackathon demo automatically uses persistent local storage.
# Set CLOUDINARY_REQUIRED=true only when Cloudinary must be mandatory.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_INVOICE_FOLDER=cogniyard/invoices
CLOUDINARY_REQUIRED=false

# Google sign-in (optional; email/password login works without it)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Browser client
VITE_API_URL=/api
VITE_PORT=3000
VITE_API_TARGET=http://127.0.0.1:5000
VITE_APP_VERSION=2.3.1

# Invoice identity
BUYER_COMPANY_NAME=CogniYard Operations
BUYER_ADDRESS=Main Yard and Procurement Centre
